# =============================================================================
# .env.local — checked-in defaults for LOCAL docker-compose development.
# Contains NO secrets (local broker runs PLAINTEXT). Loaded automatically by
# core.config when present. Override anything here with a `.env` file.
# =============================================================================

KAFKA_ENV=local

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

KAFKA_CLIENT_ID=confluent-kafka-poc
KAFKA_GROUP_ID=confluent-kafka-poc-group
KAFKA_AUTO_OFFSET_RESET=earliest

KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
# Dummy value only — the local broker does not authenticate.
KAFKA_SASL_PASSWORD=dummy-local-password
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=dummy-local-sr-secret

DEFAULT_TOPIC_PARTITIONS=3
DEFAULT_TOPIC_REPLICATION=1

LOG_LEVEL=INFO
