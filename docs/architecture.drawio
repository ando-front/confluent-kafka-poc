          <mxGeometry x="20" y="630" width="380" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Docker Compose Layer ===== -->
        <mxCell id="dockerLayer" value="Docker Compose（Confluent Platform 7.5）— docker/docker-compose.yml" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#fdf6f5;" vertex="1" parent="1">
