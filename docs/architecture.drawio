        </mxCell>
        <mxCell id="cons" value="consumer.py&lt;br&gt;BaseConsumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="coreBox">
          <mxGeometry x="255" y="35" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm" value="admin.py&lt;br&gt;AdminClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="coreBox">
          <mxGeometry x="15" y="95" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sch" value="schema.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="coreBox">
          <mxGeometry x="135" y="95" width="110" height="45" as="geometry" />
        </mxCell>

        <mxCell id="ucBox" value="use_cases/（core を継承した 7 デモ）" style="swimlane;html=1;startSize=25;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf4;" vertex="1" parent="appLayer">
          <mxGeometry x="20" y="220" width="380" height="300" as="geometry" />
        </mxCell>
        <mxCell id="uc1" value="01 basic_pubsub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ucBox">
          <mxGeometry x="15" y="35" width="170" height="45" as="geometry" />
