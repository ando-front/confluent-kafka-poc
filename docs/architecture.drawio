        </mxCell>
        <mxCell id="sr" value="Schema Registry&lt;br&gt;:8081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="dockerLayer">
