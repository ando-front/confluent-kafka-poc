        <mxCell id="uc2" value="02 event_sourcing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ucBox">
          <mxGeometry x="195" y="35" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="03 stream_processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ucBox">
          <mxGeometry x="15" y="95" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="04 cdc（Kafka Connect 利用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ucBox">
