<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram id="kafka-poc-arch" name="Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="confluent-kafka-poc アーキテクチャ" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Python Application Layer ===== -->
        <mxCell id="appLayer" value="Python アプリケーション層（Python 3.11+ / confluent-kafka）" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f5f9ff;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="420" height="730" as="geometry" />
        </mxCell>

        <mxCell id="coreBox" value="core/ 共通基盤" style="swimlane;html=1;startSize=25;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f6fbf4;" vertex="1" parent="appLayer">
          <mxGeometry x="20" y="40" width="380" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cfg" value="config.py&lt;br&gt;（.env 読込）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="coreBox">
          <mxGeometry x="15" y="35" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="prod" value="producer.py&lt;br&gt;BaseProducer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="coreBox">
