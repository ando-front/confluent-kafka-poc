        <mxCell id="broker" value="&lt;b&gt;Kafka Broker&lt;/b&gt;&lt;br&gt;:9092（JMX :9101）&lt;br&gt;トピック命名: {usecase}.{entity}.{version}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="dockerLayer">
