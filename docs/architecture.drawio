          <mxGeometry x="195" y="155" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="07 real_time_analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="ucBox">
          <mxGeometry x="15" y="215" width="170" height="45" as="geometry" />
        </mxCell>

        <mxCell id="benchBox" value="benchmarks/&lt;br&gt;スループット / レイテンシ計測" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="appLayer">
