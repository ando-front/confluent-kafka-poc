        </mxCell>
        <mxCell id="testsBox" value="tests/&lt;br&gt;pytest 統合テスト" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="appLayer">
