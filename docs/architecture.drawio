        <mxCell id="connect" value="Kafka Connect&lt;br&gt;:8083（04 CDC で利用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="dockerLayer">
          <mxGeometry x="210" y="290" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="minimalNote" value="docker-compose.minimal.yml&lt;br&gt;= ZooKeeper + Broker + kafka-ui のみの軽量構成" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=15;" vertex="1" parent="dockerLayer">
          <mxGeometry x="30" y="460" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Monitoring UI ===== -->
        <mxCell id="uiLayer" value="監視 / 管理 UI" style="swimlane;html=1;startSize=30;fontSize=13;fontStyle=1;fillColor=#d0cee2;strokeColor=#56517e;swimlaneFillColor=#f7f6fb;" vertex="1" parent="1">
          <mxGeometry x="1040" y="60" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="kafkaUi" value="kafka-ui&lt;br&gt;http://localhost:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#56517e;" vertex="1" parent="uiLayer">
          <mxGeometry x="30" y="45" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Control Center&lt;br&gt;http://localhost:9021" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#56517e;" vertex="1" parent="uiLayer">
          <mxGeometry x="30" y="130" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Confluent Cloud ===== -->
        <mxCell id="cloudNote" value="&lt;b&gt;Confluent Cloud 切替&lt;/b&gt;&lt;br&gt;.env: KAFKA_ENV=confluent&lt;br&gt;SASL_SSL + API KEY/SECRET&lt;br&gt;（コード変更不要）" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="340" width="300" height="160" as="geometry" />
        </mxCell>

        <!-- ===== .env ===== -->
        <mxCell id="envBox" value=".env（環境変数）— core/config.py 経由で注入（ハードコード禁止）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="400" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->
        <mxCell id="eInherit" value="継承" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="appLayer" source="ucBox" target="coreBox">
