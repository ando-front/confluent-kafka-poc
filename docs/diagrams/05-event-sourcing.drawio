      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Event Sourcing — 状態ではなく「起きたこと」を保存する" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#13212A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="use_cases/02_event_sourcing　トピック: eventsourcing.orders.v1" style="text;html=1;fontSize=12;fontColor=#5C7178;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="rdbF" value="従来：いまの状態だけを持つ" style="rounded=1;arcSize=6;html=1;fillColor=#FBFDFD;strokeColor=#BFD0D2;fontColor=#13212A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="330" height="192" as="geometry" />
        </mxCell>
        <mxCell id="rdbT" value="orders テーブル" style="rounded=0;html=1;fillColor=#EEF3F4;strokeColor=#9FB3B7;fontColor=#5C7178;fontSize=11;" vertex="1" parent="rdbF">
          <mxGeometry x="20" y="44" width="290" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rdbR" value="A-1001 / status = SHIPPED / 12000 円" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#C3D2D4;fontColor=#13212A;fontSize=11;" vertex="1" parent="rdbF">
          <mxGeometry x="20" y="74" width="290" height="36" as="geometry" />
        </mxCell>
        <mxCell id="rdbN" value="UPDATE で上書きしてしまうので、&#10;いつ支払われたのか・何回変更されたのかは残らない。" style="text;html=1;fontSize=11;fontColor=#B44A4A;align=left;verticalAlign=top;" vertex="1" parent="rdbF">
          <mxGeometry x="20" y="126" width="290" height="50" as="geometry" />
        </mxCell>

        <mxCell id="esF" value="イベントソーシング：起きたことを追記していく" style="rounded=1;arcSize=6;html=1;fillColor=#FBFDFD;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=12;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
