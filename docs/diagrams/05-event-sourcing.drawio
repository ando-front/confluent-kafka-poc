          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="evE3" style="html=1;endArrow=block;strokeColor=#0B7A84;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ev2" target="ev3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="lbl1" value="現在の状態を再構築する" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#13212A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1a" value="offset 0 〜 3 を全部読む" style="rounded=1;arcSize=6;html=1;fillColor=#EEF3F4;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r1b" value="畳み込む&#10;state = apply(state, event)" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="220" height="60" as="geometry" />
