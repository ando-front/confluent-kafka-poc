        <mxCell id="lbl2" value="過去の姿を再現する（リプレイ）" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#13212A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="414" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2a" value="offset 0 〜 1 で止める" style="rounded=1;arcSize=6;html=1;fillColor=#EEF3F4;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="414" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2b" value="同じ畳み込みを使う&#10;（コードは共通）" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="414" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r2c" value="支払い直後の状態&#10;status = PAID" style="rounded=1;arcSize=6;html=1;fillColor=#F7E9D4;strokeColor=#B07A28;fontColor=#6B4A12;fontSize=11;fontStyle=1;" vertex="1" parent="1">
