        <mxCell id="ev0" value="offset 0&#10;ORDER_CREATED&#10;12000 円" style="rounded=1;arcSize=4;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;" vertex="1" parent="esF">
          <mxGeometry x="20" y="46" width="156" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev1" value="offset 1&#10;PAYMENT_RECEIVED&#10;カード決済" style="rounded=1;arcSize=4;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;" vertex="1" parent="esF">
          <mxGeometry x="196" y="46" width="156" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev2" value="offset 2&#10;SHIPPED&#10;伝票 1234" style="rounded=1;arcSize=4;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;" vertex="1" parent="esF">
          <mxGeometry x="372" y="46" width="156" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev3" value="offset 3&#10;DELIVERED&#10;受領サイン" style="rounded=1;arcSize=4;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;" vertex="1" parent="esF">
          <mxGeometry x="548" y="46" width="156" height="70" as="geometry" />
        </mxCell>
        <mxCell id="esN" value="追記のみ。過去のイベントは書き換えない。だから「いつ何が起きたか」が全部残る。" style="text;html=1;fontSize=11;fontColor=#0B7A84;align=left;verticalAlign=top;" vertex="1" parent="esF">
          <mxGeometry x="20" y="130" width="680" height="40" as="geometry" />
