<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram id="confluent-cloud" name="Confluent Cloud">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Confluent Cloud への切り替え — 変わるのは .env だけ" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#13212A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="960" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="core/config.py が .env から接続設定を読むので、use_cases 側のコードは 1 行も変えずに接続先を差し替えられる。" style="text;html=1;fontSize=12;fontColor=#5C7178;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="app" value="アプリケーション側（変わらない）" style="rounded=1;arcSize=6;html=1;fillColor=#FBFDFD;strokeColor=#BFD0D2;fontColor=#13212A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="330" height="240" as="geometry" />
        </mxCell>
        <mxCell id="appuc" value="use_cases/01〜07" style="rounded=1;arcSize=6;html=1;fillColor=#EEF3F4;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=11;" vertex="1" parent="app">
          <mxGeometry x="24" y="44" width="282" height="46" as="geometry" />
        </mxCell>
        <mxCell id="appcore" value="core/　BaseProducer · BaseConsumer" style="rounded=1;arcSize=6;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;" vertex="1" parent="app">
          <mxGeometry x="24" y="102" width="282" height="46" as="geometry" />
        </mxCell>
        <mxCell id="appcfg" value="core/config.py　Settings" style="rounded=1;arcSize=6;html=1;fillColor=#F7E9D4;strokeColor=#B07A28;fontColor=#6B4A12;fontSize=11;fontStyle=1;" vertex="1" parent="app">
          <mxGeometry x="24" y="160" width="282" height="46" as="geometry" />
        </mxCell>
        <mxCell id="appe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5C7178;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="appuc" target="appcore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="appe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5C7178;strokeWidth=1.3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="appcore" target="appcfg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="envA" value="KAFKA_ENV=local　（既定）" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=12;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="envAb" value="KAFKA_BOOTSTRAP_SERVERS=localhost:9092&#10;KAFKA_SECURITY_PROTOCOL=PLAINTEXT&#10;（認証なし）" style="text;html=1;fontSize=11;fontColor=#5C7178;align=left;verticalAlign=top;" vertex="1" parent="envA">
          <mxGeometry x="20" y="40" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="envAn" value="Docker が手元に立っているだけ。&#10;壊しても ./scripts/reset.sh で作り直せる。" style="text;html=1;fontSize=11;fontColor=#7A8F97;align=left;verticalAlign=top;" vertex="1" parent="envA">
          <mxGeometry x="20" y="116" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="envB" value="KAFKA_ENV=confluent" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#B07A28;fontColor=#6B4A12;fontSize=12;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="envBb" value="KAFKA_BOOTSTRAP_SERVERS=&#10;　　pkc-xxx.aws.confluent.cloud:9092&#10;KAFKA_SECURITY_PROTOCOL=SASL_SSL&#10;KAFKA_SASL_MECHANISM=PLAIN&#10;KAFKA_SASL_USERNAME=&lt;API_KEY&gt;&#10;KAFKA_SASL_PASSWORD=&lt;API_SECRET&gt;" style="text;html=1;fontSize=11;fontColor=#6B4A12;align=left;verticalAlign=top;" vertex="1" parent="envB">
          <mxGeometry x="20" y="40" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="envBn" value="API キーは .env に置く。&#10;.env は .gitignore 済み — コミットしない。" style="text;html=1;fontSize=11;fontColor=#B44A4A;align=left;verticalAlign=top;" vertex="1" parent="envB">
          <mxGeometry x="20" y="166" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="localK" value="ローカル Docker&#10;ZooKeeper + Broker + UI&#10;自分で起動・停止・削除する" style="rounded=1;arcSize=6;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="110" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cloudK" value="Confluent Cloud&#10;マネージドクラスター&#10;起動・冗長化・パッチは向こう持ち&#10;（従量課金・認証必須）" style="rounded=1;arcSize=6;html=1;fillColor=#F7E9D4;strokeColor=#B07A28;fontColor=#6B4A12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="330" width="310" height="170" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07A28;strokeWidth=1.6;exitX=1;exitY=0.72;entryX=0;entryY=0.35;" edge="1" parent="1" source="app" target="envA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1l" value="どちらか一方を読む" style="edgeLabel;html=1;fontSize=10;fontColor=#B07A28;labelBackgroundColor=#FFFFFF;" vertex="1" parent="e1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="34" y="-12" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07A28;strokeWidth=1.6;dashed=1;exitX=1;exitY=0.85;entryX=0;entryY=0.3;" edge="1" parent="1" source="app" target="envB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B7A84;strokeWidth=1.6;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="envA" target="localK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B07A28;strokeWidth=1.6;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="envB" target="cloudK">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="学習の要点：接続設定を 1 か所に閉じ込めておくと、ローカルで作ったものがそのままマネージドサービスで動く。&#10;逆に接続情報をコードに散らすと、この差し替えができなくなる。" style="rounded=1;arcSize=6;html=1;fillColor=#F4F8F8;strokeColor=#BFD0D2;fontColor=#13212A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="552" width="1080" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
