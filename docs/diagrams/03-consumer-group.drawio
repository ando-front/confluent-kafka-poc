        <mxCell id="title" value="Consumer Group — 同じグループなら分担、違うグループなら全員が全件" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#13212A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="960" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="パーティションは 1 グループ内で必ず 1 台のコンシューマーにだけ割り当たる。これが並列度の上限になる。" style="text;html=1;fontSize=12;fontColor=#5C7178;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="960" height="20" as="geometry" />
        </mxCell>

