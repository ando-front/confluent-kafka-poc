        <mxCell id="t2" value="analytics.kpi.v1&#10;1 分ごとの KPI" style="rounded=1;arcSize=6;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="320" width="200" height="80" as="geometry" />
