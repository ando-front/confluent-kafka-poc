<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram id="realtime-analytics" name="Real-Time Analytics">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Real-Time Analytics — 生イベント → 集計 → ダッシュボードの 3 段" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#13212A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="960" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="use_cases/07_real_time_analytics　3 つのプロセスをトピックでつなぐ。それぞれ独立に起動・停止できる。" style="text;html=1;fontSize=12;fontColor=#5C7178;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="960" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="ターミナル 3　イベント生成" style="rounded=1;arcSize=6;html=1;fillColor=#FBFDFD;strokeColor=#BFD0D2;fontColor=#13212A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="s1b" value="event_producer.py&#10;page_view / add_to_cart / purchase&#10;を EC サイト風に発生させる" style="rounded=1;arcSize=6;html=1;fillColor=#EEF3F4;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=11;" vertex="1" parent="s1">
          <mxGeometry x="20" y="40" width="260" height="96" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="analytics.events.v1&#10;生イベント（1 件 = 1 行動）" style="rounded=1;arcSize=6;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="136" width="200" height="88" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="ターミナル 2　集計エンジン" style="rounded=1;arcSize=6;html=1;fillColor=#FBFDFD;strokeColor=#BFD0D2;fontColor=#13212A;fontSize=11;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="s2b" value="aggregator.py&#10;1 分ウィンドウで PV 数・CV 数・売上を&#10;数え上げて KPI にする" style="rounded=1;arcSize=6;html=1;fillColor=#EEF3F4;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=11;" vertex="1" parent="s2">
          <mxGeometry x="20" y="40" width="260" height="96" as="geometry" />
