        <mxCell id="s3" value="ターミナル 1　ダッシュボード" style="rounded=1;arcSize=6;html=1;fillColor=#FBFDFD;strokeColor=#1F7A5C;fontColor=#14513D;fontSize=11;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="890" y="290" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s3b" value="dashboard.py&#10;rich でコンソールに&#10;リアルタイム表示" style="rounded=1;arcSize=6;html=1;fillColor=#DCF0E7;strokeColor=#1F7A5C;fontColor=#14513D;fontSize=11;" vertex="1" parent="s3">
          <mxGeometry x="20" y="40" width="190" height="80" as="geometry" />
