<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram id="cdc" name="CDC">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CDC — DB の変更そのものをイベントにして届ける" style="text;html=1;fontSize=19;fontStyle=1;fontColor=#13212A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="use_cases/04_cdc　source.db（SQLite）の変更を cdc.orders.v1 経由で replica.db に反映する" style="text;html=1;fontSize=12;fontColor=#5C7178;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="960" height="20" as="geometry" />
        </mxCell>

        <mxCell id="bad" value="× ポーリング方式：SELECT * WHERE updated_at &gt; ? を定期実行" style="rounded=1;arcSize=6;html=1;fillColor=#F8E0E0;strokeColor=#B44A4A;fontColor=#7A2727;fontSize=12;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="1080" height="96" as="geometry" />
        </mxCell>
        <mxCell id="badN" value="・DELETE を検知できない（消えた行は SELECT に出てこない）　・間隔の分だけ必ず遅れる　・DB に定期的な負荷をかけ続ける&#10;・ポーリング間隔の中で 2 回更新されると、途中の状態が失われる" style="text;html=1;fontSize=11;fontColor=#7A2727;align=left;verticalAlign=top;" vertex="1" parent="bad">
          <mxGeometry x="20" y="36" width="1040" height="48" as="geometry" />
        </mxCell>

        <mxCell id="src" value="source.db&#10;（SQLite）" style="rounded=1;arcSize=6;html=1;fillColor=#EEF3F4;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="248" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sim" value="simulator.py&#10;INSERT / UPDATE / DELETE&#10;を発生させる" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="352" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="topic" value="Topic: cdc.orders.v1　—　1 変更 = 1 イベント（Debezium 形式）" style="rounded=1;arcSize=6;html=1;fillColor=#FBFDFD;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=12;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="270" y="228" width="560" height="270" as="geometry" />
        </mxCell>
        <mxCell id="evC" value="op = c（create）&#10;before = null&#10;after  = { id:1, status:'NEW' }" style="rounded=1;arcSize=4;html=1;fillColor=#DCF0E7;strokeColor=#1F7A5C;fontColor=#14513D;fontSize=11;align=left;" vertex="1" parent="topic">
          <mxGeometry x="24" y="48" width="512" height="60" as="geometry" />
        </mxCell>
        <mxCell id="evU" value="op = u（update）&#10;before = { id:1, status:'NEW' }&#10;after  = { id:1, status:'PAID' }" style="rounded=1;arcSize=4;html=1;fillColor=#D6EDEF;strokeColor=#0B7A84;fontColor=#0A3F45;fontSize=11;align=left;" vertex="1" parent="topic">
          <mxGeometry x="24" y="118" width="512" height="60" as="geometry" />
        </mxCell>
        <mxCell id="evD" value="op = d（delete）&#10;before = { id:1, status:'PAID' }&#10;after  = null　←　これがあるから削除も伝わる" style="rounded=1;arcSize=4;html=1;fillColor=#F7E9D4;strokeColor=#B07A28;fontColor=#6B4A12;fontSize=11;align=left;" vertex="1" parent="topic">
          <mxGeometry x="24" y="188" width="512" height="60" as="geometry" />
        </mxCell>

        <mxCell id="rep" value="cdc_consumer.py&#10;op を見て&#10;INSERT / UPDATE / DELETE を適用" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="890" y="268" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="dst" value="replica.db&#10;（SQLite）" style="rounded=1;arcSize=6;html=1;fillColor=#EEF3F4;strokeColor=#9FB3B7;fontColor=#13212A;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="382" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5C7178;strokeWidth=1.4;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sim" target="src">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B7A84;strokeWidth=1.6;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="src" target="topic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2l" value="発行" style="edgeLabel;html=1;fontSize=10;fontColor=#0B7A84;labelBackgroundColor=#FFFFFF;" vertex="1" parent="e2">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#0B7A84;strokeWidth=1.6;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="topic" target="rep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5C7178;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rep" target="dst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="○ CDC：変更が起きた瞬間に before / after / op を載せて発行する。削除も欠落も取りこぼさず、DB にポーリング負荷もかけない。&#10;動作確認は簡単 — source.db と replica.db を両方 SELECT して、中身が一致していればレプリケーションが成立している。" style="rounded=1;arcSize=6;html=1;fillColor=#DCF0E7;strokeColor=#1F7A5C;fontColor=#14513D;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1080" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
