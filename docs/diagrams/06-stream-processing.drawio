        <mxCell id="f1" value="① タンブリングウィンドウ集計 — 30 秒ごとに区切って売上を合計する" style="rounded=1;arcSize=6;html=1;fillColor=#FBFDFD;strokeColor=#BFD0D2;fontColor=#13212A;fontSize=12;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
